{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "draft_id",
    "account",
    "product",
    "skill",
    "brief",
    "cost"
  ],
  "properties": {
    "assembly_recipe": {"type":"string","enum":["tianyiqing-r07-v1","tianyiqing-r07-v2","tianyiqing-r07-v3"]},
    "draft_id": {
      "type": "string",
      "minLength": 1
    },
    "account": {
      "type": "string",
      "minLength": 1
    },
    "parent_id": {
      "type": "string",
      "minLength": 1
    },
    "brief": {
      "type": "string",
      "minLength": 1
    },
    "script_text": {
      "type": "string",
      "minLength": 1
    },
    "entry_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "snapshot_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product_id",
        "name",
        "documents"
      ],
      "properties": {
        "product_id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "documents": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "document_id",
              "text"
            ],
            "properties": {
              "document_id": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paid_enabled",
        "job_limit_micros",
        "daily_limit_micros",
        "max_paid_requests"
      ],
      "properties": {
        "paid_enabled": {
          "type": "boolean"
        },
        "job_limit_micros": {
          "type": "integer",
          "minimum": 1
        },
        "daily_limit_micros": {
          "type": "integer",
          "minimum": 1
        },
        "max_paid_requests": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
