{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:laox:auto-postprod:narration-plan-v1",
  "title": "Confirmed narration audio and its sentence windows",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "job_id", "revision", "source", "script", "sentences", "confirmation"],
  "properties": {
    "schema_version": {"const": "narration-plan/v1"},
    "job_id": {"$ref": "#/$defs/id"},
    "revision": {"type": "integer", "minimum": 1},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "preset", "voice", "audio_path", "audio_sha256", "actual_duration_ticks", "origin", "config_hash"],
      "properties": {
        "mode": {"enum": ["auto", "uploaded", "history"]},
        "preset": {"oneOf": [{"type": "null"}, {"type": "string", "maxLength": 128}]},
        "voice": {"$ref": "#/$defs/id", "description": "TTS voice id from the account profile."},
        "audio_path": {"$ref": "#/$defs/path"},
        "audio_sha256": {"$ref": "#/$defs/hash"},
        "actual_duration_ticks": {"type": "integer", "minimum": 1},
        "origin": {
          "type": "object", "additionalProperties": false, "required": ["kind", "ref"],
          "properties": {
            "kind": {"enum": ["tts_local_cosy", "user_imported_audio", "prior_confirmed_narration"]},
            "ref": {"oneOf": [{"type": "null"}, {
              "type": "object", "additionalProperties": false,
              "properties": {"job_id": {"$ref": "#/$defs/id"}, "revision": {"type": "integer", "minimum": 1}}
            }]}
          }
        },
        "config_hash": {"oneOf": [{"type": "null"}, {"type": "string", "maxLength": 128}]}
      }
    },
    "script": {
      "type": "object", "additionalProperties": false, "required": ["script_sha256", "sentence_count"],
      "properties": {"script_sha256": {"$ref": "#/$defs/hash"}, "sentence_count": {"type": "integer", "minimum": 1}}
    },
    "sentences": {
      "type": "array", "minItems": 1, "items": {
        "type": "object", "additionalProperties": false,
        "required": ["sentence_id", "in_tick", "out_tick", "alignment_evidence_sha256", "status"],
        "properties": {
          "sentence_id": {"$ref": "#/$defs/id"},
          "in_tick": {"oneOf": [{"type": "null"}, {"type": "integer", "minimum": 0}]},
          "out_tick": {"oneOf": [{"type": "null"}, {"type": "integer", "minimum": 1}]},
          "alignment_evidence_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/hash"}],
            "description": "Hash of the ASR alignment evidence backing this window; unknown windows stay null and are never guessed."},
          "status": {"enum": ["aligned", "unknown"]}
        }
      }
    },
    "confirmation": {"oneOf": [{"type": "null"}, {
      "type": "object", "additionalProperties": false,
      "required": ["confirmed", "operator_id", "audio_sha256_at_confirm"],
      "properties": {
        "confirmed": {"type": "boolean"},
        "operator_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "utc": {"oneOf": [{"type": "null"}, {"type": "string"}]},
        "audio_sha256_at_confirm": {"$ref": "#/$defs/hash"}
      }
    }]}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "path": {"type": "string", "minLength": 1, "maxLength": 4096}
  }
}
