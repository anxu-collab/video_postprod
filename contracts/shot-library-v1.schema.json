{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:laox:auto-postprod:shot-library-v1",
  "title": "Batch candidate library for free-pool shot selection",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "job_id", "revision", "library_sha256", "config", "candidates", "failures"],
  "properties": {
    "schema_version": {"const": "shot-library/v1"},
    "job_id": {"$ref": "#/$defs/id"},
    "revision": {"type": "integer", "minimum": 1},
    "library_sha256": {"$ref": "#/$defs/hash"},
    "sources": {
      "type": "object",
      "description": "r3: per product asset identity/bounds used to validate operator-confirmed action windows.",
      "additionalProperties": {"type": "object", "additionalProperties": false,
        "required": ["sha256", "duration_ticks", "product_identity_verified"],
        "properties": {"sha256": {"$ref": "#/$defs/hash"}, "duration_ticks": {"type": "integer", "minimum": 0},
                       "product_identity_verified": {"type": "boolean"}}}
    },
    "action_runs": {
      "type": "object",
      "description": "r3: INFERRED runs per source — adjacent observation ticks each independently attesting the same (kind, object, in-progress). PROPOSALS ONLY: inter-tick intervals are unverified gaps; only operator-confirmed intervals may auto-select.",
      "additionalProperties": {"type": "array", "items": {"$ref": "#/$defs/action_evidence"}}
    },
    "observation_grid": {
      "type": "object",
      "description": "r3: the source's sampled observation grid (tick + text) — the only temporal observations behind runs; no midpoint/tau spans.",
      "additionalProperties": {"type": "array", "items": {"type": "object", "additionalProperties": false,
        "required": ["tick", "text"],
        "properties": {"tick": {"type": "integer", "minimum": 0}, "text": {"type": "string", "maxLength": 200}}}}
    },
    "config": {
      "type": "object", "additionalProperties": false,
      "required": ["use_rule_version", "min_candidate_ticks"],
      "properties": {
        "use_rule_version": {"type": "string", "maxLength": 64},
        "min_candidate_ticks": {"type": "integer", "minimum": 0},
        "detection_config_hash": {"oneOf": [{"type": "null"}, {"type": "string", "maxLength": 128}]}
      }
    },
    "candidates": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false,
        "required": ["candidate_id", "source_asset_id", "source_sha256", "in_tick", "out_tick", "use", "action_text", "product_description", "product_identity_verified", "occlusion", "clarity", "speech_locked", "evidence", "fixed_role", "usable", "unusable_reason"],
        "properties": {
          "candidate_id": {"$ref": "#/$defs/id"},
          "source_asset_id": {"$ref": "#/$defs/id"},
          "source_sha256": {"$ref": "#/$defs/hash"},
          "source_path": {"oneOf": [{"type": "null"}, {"type": "string", "maxLength": 4096}], "description": "Imported media path for UI preview; hash-checked before serving."},
          "in_tick": {"type": "integer", "minimum": 0},
          "out_tick": {"type": "integer", "minimum": 1},
          "use": {"enum": ["packaging", "open_box", "detail", "takeout", "wrapup", "other"]},
          "supported_actions": {
            "type": "array",
            "description": "r3: INFERRED action runs overlapping this window (per-observation evidence, never re-judged on concatenated text). PROPOSALS ONLY — never auto-selected.",
            "items": {"$ref": "#/$defs/action_evidence"}
          },
          "action_text": {"oneOf": [{"type": "null"}, {"type": "string", "maxLength": 6000}]},
          "product_description": {"oneOf": [{"type": "null"}, {"type": "string", "maxLength": 6000}]},
          "product_identity_verified": {"type": "boolean"},
          "occlusion": {"enum": ["unknown", "none", "partial", "severe"]},
          "clarity": {"enum": ["unknown", "clear", "soft"]},
          "speech_locked": {"type": "boolean"},
          "evidence": {
            "type": "object", "additionalProperties": false,
            "required": ["analysis_evidence_sha256", "frame_count", "observation_count"],
            "properties": {
              "analysis_evidence_sha256": {"$ref": "#/$defs/hash"},
              "frame_count": {"type": "integer", "minimum": 0},
              "observation_count": {"type": "integer", "minimum": 0},
              "observation_texts": {"type": "array", "maxItems": 64, "items": {"type": "string", "maxLength": 2000}},
              "observation_ticks": {"type": "array", "maxItems": 32, "items": {"type": ["integer", "null"], "minimum": 0},
                "description": "Source ticks of the observations backing THIS window; an action candidate only spans ticks its own observations cover."},
              "sampling_interval_ticks": {"oneOf": [{"type": "null"}, {"type": "integer", "minimum": 1}]},
              "per_observation": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/per_observation"}}
            }
          },
          "fixed_role": {"oneOf": [{"type": "null"}, {"enum": ["fixed_opening", "fixed_closing", "locked_body"]}],
            "description": "Always null in the free pool; fixed assets never become selectable candidates."},
          "usable": {"type": "boolean"},
          "unusable_reason": {"oneOf": [{"type": "null"}, {"type": "string", "maxLength": 500}]}
        },
        "description": "Windows come from analysis coverage or scene-detection cuts; neither proves exact action boundaries, so planners may only sub-window inside them."
      }
    },
    "failures": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false,
        "required": ["asset_id", "source_sha256", "reason"],
        "properties": {
          "asset_id": {"$ref": "#/$defs/id"},
          "source_sha256": {"$ref": "#/$defs/hash"},
          "reason": {"type": "string", "minLength": 1, "maxLength": 500}
        }
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "action_evidence": {"type": "object", "additionalProperties": false,
      "required": ["kind", "object", "evidence", "ticks", "span", "basis"],
      "properties": {
        "kind": {"enum": ["open_packaging", "split_fruit", "takeout", "wrapup"]},
        "object": {"enum": ["packaging", "fruit", "flesh", "product", "tool", "unknown"]},
        "evidence": {"enum": ["inferred_run", "attested_tick"]},
        "ticks": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}},
        "span": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 0}},
        "basis": {"type": "string", "minLength": 1, "maxLength": 500},
        "gaps": {"type": "array", "items": {"type": "object", "additionalProperties": false,
          "required": ["from", "to", "ticks", "verified"],
          "properties": {"from": {"type": "integer", "minimum": 0}, "to": {"type": "integer", "minimum": 0},
                         "ticks": {"type": "integer", "minimum": 0}, "verified": {"const": false}}}}
      }},
    "per_observation": {"type": "object", "additionalProperties": false,
      "required": ["tick", "actions", "display"],
      "properties": {
        "tick": {"oneOf": [{"type": "null"}, {"type": "integer", "minimum": 0}]},
        "actions": {"type": "array", "items": {"type": "object", "additionalProperties": false,
          "required": ["kind", "object", "state"],
          "properties": {"kind": {"enum": ["open_packaging", "split_fruit", "takeout", "wrapup"]},
                         "object": {"enum": ["packaging", "fruit", "flesh", "product", "tool", "unknown"]},
                         "state": {"enum": ["in_progress", "completed", "unspecified"]}}}},
        "display": {"enum": ["detail", "packaging", "other"]}
      }}
  }
}
